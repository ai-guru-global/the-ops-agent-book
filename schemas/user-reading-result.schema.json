{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-ops-agent-book.example/schemas/user-reading-result.schema.json",
  "title": "Anonymized real-user reading test result",
  "description": "Validates one pseudonymous participant record for PUB-04. This schema does not create evidence; only completed real sessions may be submitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "participant_id",
    "role",
    "years_experience",
    "agent_project_experience",
    "consent",
    "environment",
    "tasks",
    "issues",
    "feedback"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "participant_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$",
      "description": "Pseudonymous ID only; no name, email, phone, employee ID or customer identifier."
    },
    "role": {"enum": ["sre", "platform", "ai", "docs"]},
    "years_experience": {"type": "integer", "minimum": 0, "maximum": 60},
    "agent_project_experience": {"type": "boolean"},
    "consent": {"const": true},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop_viewport", "mobile_viewport", "print_checked", "site_commit_sha", "tested_at"],
      "properties": {
        "desktop_viewport": {"const": "1440x900"},
        "mobile_viewport": {"const": "390x844"},
        "print_checked": {"const": true},
        "site_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tested_at": {"type": "string", "format": "date-time"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/task"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["most_confusing", "most_useful"],
      "properties": {
        "most_confusing": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "most_useful": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "success", "time_seconds", "wrong_turns", "help_used", "safety_misunderstanding"],
      "properties": {
        "id": {"enum": ["T1", "T2", "T3", "T4"]},
        "success": {"type": "boolean"},
        "time_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "wrong_turns": {"type": "integer", "minimum": 0, "maximum": 1000},
        "help_used": {"type": "boolean"},
        "safety_misunderstanding": {"type": "boolean"},
        "diagram_clarity": {"type": "integer", "minimum": 1, "maximum": 5},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "location", "description", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^UXR-[0-9]{3}$"},
        "severity": {"enum": ["critical", "serious", "moderate", "minor"]},
        "location": {"type": "string", "minLength": 1, "maxLength": 300},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "status": {"enum": ["open", "closed"]},
        "resolution": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
