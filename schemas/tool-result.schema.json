{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:the-ops-agent-book:tool-result:1.0.0",
  "title": "Tool result with explicit partial-success semantics",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_classification", "plan_version", "step_id", "idempotency_key", "status", "partial_success", "steps", "error"],
  "properties": {
    "data_classification": {"const": "synthetic/desensitized"},
    "plan_version": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "status": {"enum": ["succeeded", "failed", "unknown"]},
    "partial_success": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["succeeded", "failed", "skipped", "unknown"]},
          "deleted_before": {"type": "string", "format": "date-time"},
          "error_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "outcome_known"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "outcome_known": {"type": "boolean"}
      }
    },
    "filesystem_usage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "subsequent_steps": {"enum": ["stopped", "continued"]},
    "recovery_decision": {"type": "string", "minLength": 1},
    "irreversible_loss": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"properties": {"partial_success": {"const": true}}}
    }
  ]
}
