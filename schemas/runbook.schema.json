{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-ops-agent-book.example/schemas/runbook.schema.json",
  "title": "Runbook 2.0 machine-readable contract",
  "description": "Validates metadata, tool inputs, per-step evidence/assertions, change controls, confidence calibration, verification and rollback. Example domain is synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "version",
    "owner",
    "status",
    "updated_at",
    "review_by",
    "related_artifacts",
    "environments",
    "variables",
    "input_schemas",
    "confidence_calibration",
    "preconditions",
    "steps",
    "verification",
    "rollback",
    "escalation",
    "evidence_retention_days"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^RB-[a-z0-9-]+-[0-9]{4}-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "status": {
      "enum": ["draft", "in_review", "approved", "retired"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "related_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["dev", "staging", "prod"]}
    },
    "variables": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "description"],
        "properties": {
          "type": {"enum": ["string", "integer", "boolean"]},
          "description": {"type": "string", "minLength": 1},
          "secret": {"type": "boolean", "default": false}
        }
      }
    },
    "input_schemas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
      "additionalProperties": {
        "$ref": "#/$defs/toolInputSchema"
      }
    },
    "confidence_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "suite_version",
        "sample_size",
        "method",
        "threshold",
        "calibration_evidence",
        "recalibrate_when"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "suite_version": {"type": "string", "minLength": 1},
        "sample_size": {"type": "integer", "minimum": 60, "description": "Agent confidence/threshold calibration minimum for the synthetic starter. Independent Judge acceptance calibration is defined separately and requires at least 300 cases."},
        "method": {"type": "string", "minLength": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "calibration_evidence": {"type": "string", "minLength": 1},
        "recalibrate_when": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expression", "evidence_source", "fresh_within", "on_failure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "expression": {"type": "string", "minLength": 1},
          "evidence_source": {"type": "string", "minLength": 1},
          "fresh_within": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
          "on_failure": {"enum": ["abort", "escalate"]}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/step"}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "rto_minutes", "steps", "verification"],
      "properties": {
        "trigger": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rto_minutes": {"type": "integer", "minimum": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "to", "response_minutes", "handoff_fields"],
      "properties": {
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "to": {"$ref": "#/$defs/owner"},
        "response_minutes": {"type": "integer", "minimum": 1},
        "handoff_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_retention_days": {"type": "integer", "minimum": 30}
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "backup"],
      "properties": {
        "team": {"type": "string", "minLength": 1},
        "backup": {"type": "string", "minLength": 1}
      }
    },
    "toolInputSchema": {
      "type": "object",
      "required": ["type", "additionalProperties", "required", "properties"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["string", "integer", "boolean", "object", "array"]},
              "minLength": {"type": "integer", "minimum": 1},
              "minimum": {"type": "integer", "minimum": 0},
              "enum": {"type": "array", "minItems": 1},
              "items": {"type": "object"}
            }
          }
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fresh_within"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "fresh_within": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "required_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expression", "expected", "timeout_seconds", "on_failure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "expression": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "on_failure": {"enum": ["abort", "retry", "rollback", "escalate"]}
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "failure"],
      "properties": {
        "success": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "failure": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action_class",
        "purpose",
        "evidence",
        "tool",
        "tool_version",
        "input_schema_ref",
        "params",
        "timeout_seconds",
        "assertions"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "action_class": {"enum": ["read", "plan", "approval", "write", "verify", "rollback"]},
        "purpose": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRequirement"}
        },
        "tool": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
        "tool_version": {"type": "string", "minLength": 1},
        "input_schema_ref": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "assertions": {"$ref": "#/$defs/assertions"},
        "dry_run": {"type": "boolean"},
        "approval": {"type": "object"},
        "rollback_step_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"action_class": {"const": "write"}}, "required": ["action_class"]},
          "then": {
            "required": ["dry_run", "approval", "rollback_step_refs"],
            "properties": {
              "dry_run": {"const": true},
              "approval": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_approvers", "roles", "expires_in_minutes", "change_window_required"],
                "properties": {
                  "min_approvers": {"type": "integer", "minimum": 1},
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "expires_in_minutes": {"type": "integer", "minimum": 1},
                  "change_window_required": {"type": "boolean"}
                }
              },
              "rollback_step_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              }
            }
          }
        }
      ]
    }
  }
}
