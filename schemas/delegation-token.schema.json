{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:the-ops-agent-book:delegation-token:1.0.0",
  "title": "Synthetic short-lived workload identity delegation token",
  "type": "object",
  "additionalProperties": false,
  "required": ["iss", "sub", "aud", "exp", "nbf", "jti", "tenant", "purpose", "act", "delegation", "scope"],
  "properties": {
    "iss": {"type": "string", "format": "uri"},
    "sub": {"type": "string", "pattern": "^nhai:agent:[a-z0-9-]+:[A-Za-z0-9_-]+$"},
    "aud": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exp": {"type": "integer", "minimum": 1},
    "nbf": {"type": "integer", "minimum": 1},
    "jti": {"type": "string", "minLength": 1},
    "tenant": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub"],
      "properties": {"sub": {"type": "string", "minLength": 1}}
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "non_transferable", "max_depth"],
      "properties": {
        "chain": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "non_transferable": {"const": true},
        "max_depth": {"const": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "environment"],
      "properties": {
        "tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "string", "minLength": 1}
      }
    }
  }
}
